---
// web/src/pages/courses/lesson.astro
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/organisms/Navbar.astro';
import Footer from '@/components/organisms/Footer.astro';
import LessonHeader from '@/components/lesson/LessonHeader.astro';
import ExerciseInstructionPane from '@/components/lesson/ExerciseInstructionPane.astro';
import LessonEditorPane from '@/components/lesson/LessonEditorPane.astro';
---

<Layout title="KODINGAN — Pelajaran & Latihan Koding">
	<Navbar />

	<main class="w-full pt-[75px] pb-12 bg-[#131316] min-h-[calc(100vh-60px)] flex flex-col justify-between items-center px-3 sm:px-6 md:px-8">
		<div class="w-full max-w-[1720px] mx-auto flex flex-col gap-5">
			
			<!-- TOP NAVIGATION & BREADCRUMB -->
			<div class="flex items-center justify-between flex-wrap gap-2">
				<a
					id="btn-back-course"
					href="/courses"
					class="font-mono text-xs text-[#d1c6ab] hover:text-[#facc15] flex items-center gap-1.5 transition-colors"
				>
					<span>&larr;</span>
					<span>[ KEMBALI KE SILABUS ]</span>
				</a>

				<div class="flex items-center gap-3">
					<span id="lesson-status-pill" class="font-mono text-[11px] text-[#4edea3] bg-[#003824] px-2 py-0.5 border border-[#4edea3]">
						MODE_BELAJAR
					</span>
					<span class="font-mono text-[11px] text-[#ffecb9] bg-[#1b1b1e] px-2 py-0.5 border border-[#353438] hidden sm:inline">
						AKSES_BEBAS (NO HARD LOCK)
					</span>
				</div>
			</div>

			<!-- LOADING STATE -->
			<div id="lesson-loading" class="w-full py-24 flex flex-col items-center justify-center gap-3">
				<div class="w-8 h-8 border-4 border-[#353438] border-t-[#facc15] rounded-full animate-spin"></div>
				<p class="font-mono text-xs text-[#d1c6ab] tracking-wider uppercase animate-pulse">
					MEMUAT_MATERI_DAN_LATIHAN...
				</p>
			</div>

			<!-- ERROR STATE -->
			<div id="lesson-error" class="hidden w-full bg-[#1F080A] border-2 border-[#ffb4ab] p-8 text-center flex-col items-center gap-3 shadow-[6px_6px_0px_#93000a]">
				<span class="material-symbols-outlined text-4xl text-[#ffb4ab]">error</span>
				<h3 class="font-mono text-sm font-bold text-[#ffb4ab] uppercase">Pelajaran Tidak Ditemukan</h3>
				<p id="lesson-error-msg" class="font-mono text-xs text-[#ffdad6] max-w-md">
					Materi pelajaran yang Anda tuju tidak ditemukan atau belum tersedia di sistem.
				</p>
				<a
					href="/courses"
					class="mt-3 font-mono text-xs font-bold px-4 py-2 bg-[#ffb4ab] text-[#690005] border-2 border-black shadow-[3px_3px_0px_#000000] hover:translate-x-0.5 hover:translate-y-0.5 uppercase"
				>
					[ Kembali ke Daftar Kursus ]
				</a>
			</div>

			<!-- LESSON MAIN CONTAINER -->
			<div id="lesson-content" class="hidden flex-col gap-5 w-full">
				
				<!-- 1. LESSON HEADER WINDOW -->
				<LessonHeader />

				<!-- 2. EXERCISE TAB SELECTOR (IF MULTIPLE EXERCISES) -->
				<div id="exercise-tabs-container" class="w-full bg-[#1b1b1e] border-2 border-[#353438] p-2 flex items-center gap-2 overflow-x-auto shadow-[4px_4px_0px_#000000]">
					<span class="font-mono text-xs text-[#9a9078] px-2 shrink-0 uppercase font-bold">LATIHAN:</span>
					<div id="exercise-tabs-list" class="flex items-center gap-2">
						<!-- Injected dynamically by lesson-workspace.ts -->
					</div>
				</div>

				<!-- 3. WORKSPACE SPLIT: LEFT INSTRUCTIONS & THEORY, RIGHT EDITOR & RUNNER -->
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start w-full">
					<ExerciseInstructionPane />
					<LessonEditorPane />
				</div>

				<!-- 4. BOTTOM ACTIONS -->
				<div class="w-full bg-[#1b1b1e] border-2 border-[#353438] p-4 flex items-center justify-between shadow-[4px_4px_0px_#000000] mt-2">
					<a
						id="bottom-back-link"
						href="/courses"
						class="font-mono text-xs text-[#d1c6ab] hover:text-[#e4e1e6] px-3 py-2 bg-[#0e0e11] border border-[#353438] transition-colors"
					>
						&larr; Silabus Kursus
					</a>

					<a
						href="/playground"
						class="font-mono text-xs font-bold text-[#facc15] hover:underline"
					>
						Buka Area Uji Coba (Playground) &rarr;
					</a>
				</div>

			</div>

		</div>

		<!-- FOOTER -->
		<div class="w-full max-w-[1720px] mx-auto mt-12">
			<Footer />
		</div>
	</main>
</Layout>

<script>
	import { initLessonWorkspace } from '@/lib/lesson-workspace';

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initLessonWorkspace);
	} else {
		initLessonWorkspace();
	}
</script>

