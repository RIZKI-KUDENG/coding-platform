---
// web/src/pages/register.astro
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/organisms/Navbar.astro';
import Footer from '@/components/organisms/Footer.astro';
---

<Layout title="KODINGAN — Buat Akun Baru">
	<Navbar />

	<main class="w-full pt-[80px] pb-16 bg-[#131316] min-h-[calc(100vh-60px)] flex flex-col justify-between items-center px-4">
		<div class="w-full max-w-md my-auto flex flex-col items-center">
			
			<!-- Neo-Brutalist Auth Container -->
			<div class="w-full bg-[#0e0e11] border-2 border-[#353438] shadow-[8px_8px_0px_#000000] overflow-hidden">
				
				<!-- Window Title Bar -->
				<div class="w-full bg-[#1b1b1e] border-b-2 border-[#353438] px-4 py-2.5 flex items-center justify-between">
					<div class="flex items-center gap-2">
						<span class="w-3 h-3 bg-[#4edea3] inline-block border border-black"></span>
						<span class="font-mono text-xs font-bold text-[#ffecb9] tracking-wider">SECURE_AUTH // REGISTER</span>
					</div>
					<div class="font-mono text-[11px] text-[#facc15] bg-[#352b00] px-1.5 py-0.5 border border-[#facc15]">
						NEW USER: ONBOARDING
					</div>
				</div>

				<!-- Card Content -->
				<div class="p-6 md:p-8 flex flex-col gap-6">
					
					<!-- Header Section -->
					<div>
						<h1 class="font-['Space_Grotesk'] text-2xl md:text-3xl font-bold text-[#e4e1e6] uppercase tracking-tight">
							Daftar Akun
						</h1>
						<p class="font-mono text-xs text-[#d1c6ab] mt-1.5 leading-relaxed">
							Mulai petualangan koding Anda, kumpulkan XP, dan catat riwayat eksekusi kode di KODINGAN.
						</p>
					</div>

					<!-- Error Notification Box (Dynamic) -->
					<div
						id="auth-error-box"
						class="hidden bg-[#1F080A] border-2 border-[#ffb4ab] p-3 text-xs text-[#ffb4ab] shadow-[3px_3px_0px_#93000a] flex-col gap-1 font-mono"
					>
						<div class="flex items-center gap-1.5 font-bold uppercase">
							<span class="material-symbols-outlined text-[16px]">error</span>
							<span id="auth-error-title">GAGAL MENDAFTAR</span>
						</div>
						<p id="auth-error-msg" class="text-[11px] text-[#ffdad6] pl-5.5 leading-tight"></p>
					</div>

					<!-- Register Form -->
					<form id="register-form" class="flex flex-col gap-4" novalidate>
						
						<!-- Input Username -->
						<div class="flex flex-col gap-1.5">
							<label for="username" class="font-mono text-xs font-bold text-[#d1c6ab] uppercase tracking-wider flex items-center justify-between">
								<span>Username Pengguna</span>
								<span class="text-[#facc15]">*</span>
							</label>
							<div class="relative">
								<input
									type="text"
									id="username"
									name="username"
									autocomplete="username"
									required
									placeholder="cth: kudeng_dev"
									class="w-full bg-[#121215] border-2 border-[#353438] focus:border-[#facc15] text-[#e4e1e6] placeholder-[#6f6b64] font-mono text-sm px-3.5 py-2.5 outline-none transition-colors"
								/>
							</div>
							<span class="text-[11px] font-mono text-[#9a9078]">Gunakan huruf kecil, angka, atau underscore.</span>
						</div>

						<!-- Input Email -->
						<div class="flex flex-col gap-1.5">
							<label for="email" class="font-mono text-xs font-bold text-[#d1c6ab] uppercase tracking-wider flex items-center justify-between">
								<span>Email Aktif</span>
								<span class="text-[#facc15]">*</span>
							</label>
							<div class="relative">
								<input
									type="email"
									id="email"
									name="email"
									autocomplete="email"
									inputmode="email"
									required
									placeholder="nama@email.com"
									class="w-full bg-[#121215] border-2 border-[#353438] focus:border-[#facc15] text-[#e4e1e6] placeholder-[#6f6b64] font-mono text-sm px-3.5 py-2.5 outline-none transition-colors"
								/>
							</div>
						</div>

						<!-- Input Password -->
						<div class="flex flex-col gap-1.5">
							<label for="password" class="font-mono text-xs font-bold text-[#d1c6ab] uppercase tracking-wider flex items-center justify-between">
								<span>Kata Sandi Baru</span>
								<span class="text-[#facc15]">*</span>
							</label>
							<div class="relative flex items-center">
								<input
									type="password"
									id="password"
									name="password"
									autocomplete="new-password"
									required
									placeholder="Minimal 6 karakter"
									class="w-full bg-[#121215] border-2 border-[#353438] focus:border-[#facc15] text-[#e4e1e6] placeholder-[#6f6b64] font-mono text-sm pl-3.5 pr-10 py-2.5 outline-none transition-colors"
								/>
								<button
									type="button"
									id="btn-toggle-password"
									class="absolute right-2.5 text-[#d1c6ab] hover:text-[#e4e1e6] p-1 cursor-pointer flex items-center"
									title="Tampilkan / Sembunyikan Kata Sandi"
								>
									<span class="material-symbols-outlined text-[18px]" id="icon-toggle-password">visibility</span>
								</button>
							</div>
						</div>

						<!-- Submit Button -->
						<button
							type="submit"
							id="btn-submit"
							class="w-full mt-2 font-['Space_Grotesk'] text-sm font-bold uppercase tracking-wider py-3 px-4 bg-[#facc15] hover:bg-[#ffe066] text-black border-2 border-black shadow-[4px_4px_0px_#000000] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none flex items-center justify-center gap-2 cursor-pointer disabled:opacity-75 disabled:cursor-not-allowed transition-all"
						>
							<span class="material-symbols-outlined text-[18px] font-bold" id="btn-icon">person_add</span>
							<span id="btn-text">Buat Akun Baru</span>
						</button>
					</form>

					<!-- Divider -->
					<div class="w-full border-t border-[#353438] flex items-center justify-center relative my-1">
						<span class="bg-[#0e0e11] px-3 text-[11px] font-mono text-[#6f6b64] uppercase tracking-widest absolute">
							OR
						</span>
					</div>

					<!-- Secondary Link to Login -->
					<div class="text-center font-mono text-xs text-[#d1c6ab]">
						Sudah memiliki akun?{' '}
						<a
							href="/login"
							class="text-[#4edea3] hover:underline font-bold tracking-wide cursor-pointer inline-flex items-center gap-0.5 ml-1"
						>
							Masuk di Sini &rarr;
						</a>
					</div>
				</div>

				<!-- Card Bottom Diagnostics / Security Strip -->
				<div class="w-full bg-[#1b1b1e] border-t-2 border-[#353438] px-4 py-2 flex items-center justify-between text-[11px] font-mono text-[#9a9078]">
					<span>ROLE: LEARNER // GUEST_PROMOTED</span>
					<span class="text-[#4edea3]">IDENTITY_SERVICE: V1</span>
				</div>
			</div>
		</div>

		<Footer />
	</main>
</Layout>

<script>
	import { saveSession } from '@/lib/auth';

	const form = document.getElementById('register-form') as HTMLFormElement | null;
	const usernameInput = document.getElementById('username') as HTMLInputElement | null;
	const emailInput = document.getElementById('email') as HTMLInputElement | null;
	const passwordInput = document.getElementById('password') as HTMLInputElement | null;
	const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement | null;
	const btnText = document.getElementById('btn-text');
	const btnIcon = document.getElementById('btn-icon');
	const errorBox = document.getElementById('auth-error-box');
	const errorMsg = document.getElementById('auth-error-msg');
	const togglePasswordBtn = document.getElementById('btn-toggle-password');
	const togglePasswordIcon = document.getElementById('icon-toggle-password');

	// Password reveal toggle
	togglePasswordBtn?.addEventListener('click', () => {
		if (!passwordInput || !togglePasswordIcon) return;
		const isPassword = passwordInput.type === 'password';
		passwordInput.type = isPassword ? 'text' : 'password';
		togglePasswordIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
	});

	function showError(message: string) {
		if (!errorBox || !errorMsg) return;
		errorMsg.textContent = message;
		errorBox.classList.remove('hidden');
		errorBox.classList.add('flex');
	}

	function hideError() {
		if (!errorBox) return;
		errorBox.classList.add('hidden');
		errorBox.classList.remove('flex');
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		hideError();

		const username = usernameInput?.value.trim() || '';
		const email = emailInput?.value.trim() || '';
		const password = passwordInput?.value || '';

		// Client-side quick validations
		if (!username || !email || !password) {
			showError('Semua kolom wajib diisi.');
			return;
		}

		if (username.length < 3) {
			showError('Username minimal harus 3 karakter.');
			return;
		}

		if (!email.includes('@') || !email.includes('.')) {
			showError('Format email tidak valid.');
			return;
		}

		if (password.length < 6) {
			showError('Kata sandi minimal harus 6 karakter.');
			return;
		}

		if (submitBtn && btnText && btnIcon) {
			submitBtn.disabled = true;
			btnText.textContent = 'Mendaftarkan Akun...';
			btnIcon.textContent = 'hourglass_top';
		}

		try {
			const res = await fetch('/api/v1/auth/register', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					username,
					email,
					password,
				}),
			});

			const json = await res.json();

			if (!res.ok) {
				let errMsg = json.error?.message || 'Registrasi gagal diproses.';
				if (json.error?.code === 'EMAIL_ALREADY_EXISTS') {
					errMsg = 'Email tersebut sudah terdaftar. Silakan gunakan email lain atau langsung Masuk.';
				} else if (json.error?.code === 'USERNAME_ALREADY_EXISTS') {
					errMsg = 'Username sudah dipakai oleh pengguna lain. Silakan pilih username lain.';
				}
				showError(errMsg);
				return;
			}

			// Register berhasil: Simpan sesi dan arahkan pengguna
			if (json.data?.user && json.data?.access_token) {
				saveSession(json.data.user, json.data.access_token);
				window.location.href = '/playground';
			} else {
				showError('Format respons server tidak dikenali.');
			}
		} catch (err: any) {
			showError('Gagal terhubung ke backend server. Pastikan API aktif di port 3000.');
		} finally {
			if (submitBtn && btnText && btnIcon) {
				submitBtn.disabled = false;
				btnText.textContent = 'Buat Akun Baru';
				btnIcon.textContent = 'person_add';
			}
		}
	});
</script>
