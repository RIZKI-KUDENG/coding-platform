---
// web/src/pages/admin/features.astro
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/organisms/Navbar.astro";
import Footer from "@/components/organisms/Footer.astro";
---

<Layout title="KODINGAN — Admin: Sakelar Fitur (Feature Flags)">
    <Navbar />

    <main class="w-full pt-[76px] pb-16 bg-[#131316] min-h-[calc(100vh-60px)] px-4 md:px-8">
        <div class="max-w-7xl mx-auto flex flex-col gap-6">
            <!-- Access Denied Banner (Hidden by default, shown if non-admin) -->
            <div
                id="admin-denied-box"
                class="hidden bg-[#1F080A] border-2 border-[#ffb4ab] p-6 shadow-[6px_6px_0px_#93000a] flex-col items-center justify-center text-center gap-3 font-mono my-8"
            >
                <span class="material-symbols-outlined text-4xl text-[#ffb4ab]">
                    lock
                </span>
                <h2 class="text-xl font-bold text-[#ffdad6] uppercase tracking-wider font-['Space_Grotesk']">
                    Akses Ditolak — Khusus Administrator
                </h2>
                <p class="text-xs text-[#d1c6ab] max-w-md">
                    Akun Anda tidak memiliki role{" "}
                    <span class="text-[#ffb4ab] font-bold">admin</span> untuk
                    mengontrol sakelar fitur platform.
                </p>
                <div class="flex items-center gap-3 mt-2">
                    <a
                        href="/courses"
                        class="px-4 py-2 bg-[#facc15] text-[#3c2f00] font-bold text-xs border border-black shadow-[3px_3px_0px_#000000]"
                    >
                        [ Kembali ke Jalur Belajar ]
                    </a>
                    <a
                        href="/login"
                        class="px-4 py-2 bg-[#2a2a2d] text-[#e4e1e6] text-xs border border-[#353438] hover:bg-[#353438]"
                    >
                        [ Ganti Akun ]
                    </a>
                </div>
            </div>

            <!-- Main Admin Container -->
            <div id="admin-main-container" class="flex flex-col gap-6">
                <!-- Window Title Bar & Subnav Tabs -->
                <div class="w-full bg-[#0e0e11] border-2 border-[#353438] shadow-[4px_4px_0px_#000000] p-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="flex items-center gap-2.5">
                        <span class="w-3 h-3 bg-[#facc15] inline-block border border-black"></span>
                        <span class="font-mono text-xs font-bold text-[#ffecb9] tracking-wider uppercase">
                            PANEL_ADMIN // SAKELAR_FITUR (FEATURE_FLAGS)
                        </span>
                        <span class="font-mono text-[10px] text-[#4edea3] bg-[#003824] px-1.5 py-0.5 border border-[#4edea3]">
                            ROLE: ADMIN
                        </span>
                    </div>

                    <!-- Navigation Tabs -->
                    <div class="flex flex-wrap items-center gap-2">
                        <a
                            href="/admin/courses"
                            class="font-mono text-xs px-3 py-1.5 bg-[#1b1b1e] text-[#d1c6ab] border border-[#353438] hover:bg-[#2a2a2d] hover:text-[#e4e1e6]"
                        >
                            [ Kelola Kursus ]
                        </a>
                        <a
                            href="/admin/features"
                            class="font-mono text-xs px-3 py-1.5 bg-[#facc15] text-[#3c2f00] font-bold border border-black shadow-[2px_2px_0px_#000000]"
                        >
                            [ Sakelar Fitur ]
                        </a>
                        <a
                            href="/courses"
                            class="font-mono text-xs px-3 py-1.5 bg-[#1b1b1e] text-[#d1c6ab] border border-[#353438] hover:bg-[#2a2a2d] hover:text-[#e4e1e6]"
                        >
                            [ Tampilan Siswa ]
                        </a>
                    </div>
                </div>

                <!-- Stats Counter Bar -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-[#0e0e11] border-2 border-[#353438] p-4 shadow-[3px_3px_0px_#000000]">
                        <div class="font-mono text-xs text-[#9a9078] uppercase">
                            Total Fitur Terdaftar
                        </div>
                        <div
                            class="text-2xl font-bold font-mono text-[#e4e1e6] mt-1"
                            id="stat-total-features"
                        >
                            0
                        </div>
                    </div>
                    <div class="bg-[#0e0e11] border-2 border-[#353438] p-4 shadow-[3px_3px_0px_#000000]">
                        <div class="font-mono text-xs text-[#4edea3] uppercase flex items-center gap-1.5">
                            <span class="w-2 h-2 bg-[#4edea3] inline-block"></span>
                            <span>Aktif Normal</span>
                        </div>
                        <div
                            class="text-2xl font-bold font-mono text-[#4edea3] mt-1"
                            id="stat-active-features"
                        >
                            0
                        </div>
                    </div>
                    <div class="bg-[#0e0e11] border-2 border-[#353438] p-4 shadow-[3px_3px_0px_#000000]">
                        <div class="font-mono text-xs text-[#ffb4ab] uppercase flex items-center gap-1.5">
                            <span class="w-2 h-2 bg-[#ffb4ab] inline-block"></span>
                            <span>Pemeliharaan / Nonaktif</span>
                        </div>
                        <div
                            class="text-2xl font-bold font-mono text-[#ffb4ab] mt-1"
                            id="stat-disabled-features"
                        >
                            0
                        </div>
                    </div>
                </div>

                <!-- Notification Toast -->
                <div
                    id="toast-box"
                    class="hidden p-3 border-2 text-xs font-mono shadow-[3px_3px_0px_#000000] flex-row items-center justify-between gap-3"
                >
                    <span id="toast-message"></span>
                    <button
                        id="toast-close"
                        type="button"
                        class="cursor-pointer font-bold text-sm"
                    >
                        ✕
                    </button>
                </div>

                <!-- Filter & Search Toolbar -->
                <div class="bg-[#0e0e11] border-2 border-[#353438] p-4 shadow-[4px_4px_0px_#000000] flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
                    <div class="flex-1 max-w-md relative">
                        <input
                            type="text"
                            id="search-input"
                            placeholder="Cari kunci fitur (cth: courses, runner)..."
                            class="w-full bg-[#1b1b1e] border-2 border-[#353438] px-3 py-2 text-xs font-mono text-[#e4e1e6] placeholder-[#6f6b64] focus:outline-none focus:border-[#facc15]"
                        />
                    </div>

                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="font-mono text-xs text-[#9a9078] mr-1">
                            Filter:
                        </span>
                        <button
                            type="button"
                            class="filter-btn font-mono text-xs px-2.5 py-1 border border-[#353438] bg-[#facc15] text-[#3c2f00] font-bold"
                            data-filter="ALL"
                        >
                            Semua
                        </button>
                        <button
                            type="button"
                            class="filter-btn font-mono text-xs px-2.5 py-1 border border-[#353438] bg-[#1b1b1e] text-[#d1c6ab] hover:text-[#e4e1e6]"
                            data-filter="ACTIVE"
                        >
                            Aktif
                        </button>
                        <button
                            type="button"
                            class="filter-btn font-mono text-xs px-2.5 py-1 border border-[#353438] bg-[#1b1b1e] text-[#d1c6ab] hover:text-[#e4e1e6]"
                            data-filter="DISABLED"
                        >
                            Nonaktif
                        </button>
                        <button
                            type="button"
                            class="filter-btn font-mono text-xs px-2.5 py-1 border border-[#353438] bg-[#1b1b1e] text-[#d1c6ab] hover:text-[#e4e1e6]"
                            data-filter="ROOT"
                        >
                            Fitur Utama
                        </button>
                        <button
                            type="button"
                            class="filter-btn font-mono text-xs px-2.5 py-1 border border-[#353438] bg-[#1b1b1e] text-[#d1c6ab] hover:text-[#e4e1e6]"
                            data-filter="SUB"
                        >
                            Sub-Fitur
                        </button>
                    </div>
                </div>

                <!-- Feature Flags Table -->
                <div class="bg-[#0e0e11] border-2 border-[#353438] shadow-[6px_6px_0px_#000000] overflow-hidden">
                    <div class="w-full overflow-x-auto">
                        <table class="w-full text-left font-mono text-xs border-collapse">
                            <thead>
                                <tr class="bg-[#1b1b1e] border-b-2 border-[#353438] text-[#9a9078] uppercase text-[11px]">
                                    <th class="py-3 px-4 w-60">
                                        Kunci Fitur (Key)
                                    </th>
                                    <th class="py-3 px-4 w-32">Tipe</th>
                                    <th class="py-3 px-4">Deskripsi</th>
                                    <th class="py-3 px-4 w-40">
                                        Status Terkini
                                    </th>
                                    <th class="py-3 px-4 w-52 text-right">
                                        Aksi Sakelar
                                    </th>
                                </tr>
                            </thead>
                            <tbody
                                id="features-table-body"
                                class="divide-y divide-[#2a2a2d]"
                            >
                                <!-- Loading State Placeholder -->
                                <tr id="loading-row">
                                    <td
                                        colspan="5"
                                        class="py-8 text-center text-[#9a9078]"
                                    >
                                        <div class="flex items-center justify-center gap-2">
                                            <span class="w-2 h-2 bg-[#facc15] inline-block animate-ping"></span>
                                            <span>
                                                Memuat daftar sakelar fitur dari
                                                sistem...
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Empty State -->
                    <div
                        id="empty-state"
                        class="hidden py-12 px-4 flex-col items-center justify-center text-center font-mono gap-2"
                    >
                        <span class="material-symbols-outlined text-4xl text-[#9a9078]">
                            toggle_off
                        </span>
                        <p class="text-sm font-bold text-[#e4e1e6]">
                            Tidak ada feature flag yang cocok dengan pencarian.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= Modal Edit Feature Flag ================= -->
        <div
            id="edit-modal"
            class="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4 hidden backdrop-blur-xs"
        >
            <div class="w-full max-w-lg bg-[#0e0e11] border-2 border-[#353438] shadow-[8px_8px_0px_#000000] flex flex-col overflow-hidden">
                <!-- Modal Header -->
                <div class="bg-[#1b1b1e] border-b-2 border-[#353438] px-4 py-2.5 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 bg-[#facc15] inline-block border border-black"></span>
                        <span class="font-mono text-xs font-bold text-[#ffecb9] uppercase tracking-wider">
                            EDIT SAKELAR FITUR
                        </span>
                    </div>
                    <button
                        id="btn-close-modal"
                        type="button"
                        class="text-[#d1c6ab] hover:text-[#ffb4ab] font-mono text-base font-bold cursor-pointer"
                    >
                        ✕
                    </button>
                </div>

                <!-- Modal Form -->
                <form
                    id="feature-form"
                    class="p-6 flex flex-col gap-4 font-mono text-xs"
                >
                    <input type="hidden" id="modal-feature-id" value="" />

                    <div
                        id="modal-error-box"
                        class="hidden bg-[#1F080A] border-2 border-[#ffb4ab] p-3 text-[11px] text-[#ffdad6]"
                    ></div>

                    <!-- Feature Key (Read-Only) -->
                    <div class="flex flex-col gap-1.5">
                        <label
                            for="modal-feature-key"
                            class="font-bold text-[#d1c6ab] uppercase"
                        >
                            Kunci Fitur (Identifier)
                        </label>
                        <input
                            type="text"
                            id="modal-feature-key"
                            readonly
                            class="w-full bg-[#141416] border-2 border-[#2a2a2d] px-3 py-2 text-[#9a9078] cursor-not-allowed select-all"
                        />
                    </div>

                    <!-- Status Radio Toggle -->
                    <div class="flex flex-col gap-1.5">
                        <label class="font-bold text-[#d1c6ab] uppercase">
                            Status Fitur
                        </label>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="flex items-center gap-2.5 p-3 bg-[#1b1b1e] border border-[#353438] cursor-pointer hover:border-[#4edea3]">
                                <input
                                    type="radio"
                                    name="feature-status"
                                    value="1"
                                    class="accent-[#4edea3]"
                                />
                                <div>
                                    <div class="font-bold text-[#4edea3]">
                                        AKTIF (ENABLED)
                                    </div>
                                    <div class="text-[10px] text-[#9a9078]">
                                        Dapat diakses normal
                                    </div>
                                </div>
                            </label>
                            <label class="flex items-center gap-2.5 p-3 bg-[#1b1b1e] border border-[#353438] cursor-pointer hover:border-[#ffb4ab]">
                                <input
                                    type="radio"
                                    name="feature-status"
                                    value="0"
                                    class="accent-[#ffb4ab]"
                                />
                                <div>
                                    <div class="font-bold text-[#ffb4ab]">
                                        MAINTENANCE (OFF)
                                    </div>
                                    <div class="text-[10px] text-[#9a9078]">
                                        Mode pemeliharaan
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Description Textarea -->
                    <div class="flex flex-col gap-1.5">
                        <label
                            for="modal-feature-desc"
                            class="font-bold text-[#d1c6ab] uppercase"
                        >
                            Deskripsi / Catatan Fitur
                        </label>
                        <textarea
                            id="modal-feature-desc"
                            rows="3"
                            placeholder="Tuliskan keterangan modul atau alasan pemeliharaan..."
                            class="w-full bg-[#1b1b1e] border-2 border-[#353438] px-3 py-2 text-[#e4e1e6] focus:outline-none focus:border-[#facc15]"
                        ></textarea>
                    </div>

                    <!-- Modal Actions -->
                    <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-[#353438]">
                        <button
                            type="button"
                            id="btn-cancel-modal"
                            class="px-4 py-2 bg-[#2a2a2d] text-[#d1c6ab] hover:text-[#e4e1e6] border border-[#353438] cursor-pointer"
                        >
                            Batal
                        </button>
                        <button
                            type="submit"
                            id="btn-save-feature"
                            class="px-4 py-2 bg-[#facc15] text-[#3c2f00] font-bold border-2 border-[#0e0e11] shadow-[3px_3px_0px_#000000] hover:translate-x-0.5 hover:translate-y-0.5 active:translate-x-1 active:translate-y-1 cursor-pointer flex items-center gap-1.5"
                        >
                            <span class="material-symbols-outlined text-[16px]">
                                save
                            </span>
                            <span>Simpan Perubahan</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<script>
    import { isAdmin, isAuthenticated, syncCurrentUser } from "@/lib/auth";
    import {
        fetchAdminFeatures,
        updateAdminFeature,
        type AdminFeatureFlag,
    } from "@/lib/admin-features";

    let allFeatures: AdminFeatureFlag[] = [];
    let activeFilter: string = "ALL";
    let searchQuery: string = "";

    const deniedBox = document.getElementById("admin-denied-box");
    const mainContainer = document.getElementById("admin-main-container");
    const tableBody = document.getElementById("features-table-body");
    const emptyState = document.getElementById("empty-state");
    const searchInput = document.getElementById(
        "search-input",
    ) as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll(".filter-btn");

    const statTotal = document.getElementById("stat-total-features");
    const statActive = document.getElementById("stat-active-features");
    const statDisabled = document.getElementById("stat-disabled-features");

    const toastBox = document.getElementById("toast-box");
    const toastMessage = document.getElementById("toast-message");
    const toastClose = document.getElementById("toast-close");

    // Modal elements
    const editModal = document.getElementById("edit-modal");
    const featureForm = document.getElementById(
        "feature-form",
    ) as HTMLFormElement | null;
    const modalFeatureId = document.getElementById(
        "modal-feature-id",
    ) as HTMLInputElement | null;
    const modalFeatureKey = document.getElementById(
        "modal-feature-key",
    ) as HTMLInputElement | null;
    const modalFeatureDesc = document.getElementById(
        "modal-feature-desc",
    ) as HTMLTextAreaElement | null;
    const modalErrorBox = document.getElementById("modal-error-box");
    const btnCloseModal = document.getElementById("btn-close-modal");
    const btnCancelModal = document.getElementById("btn-cancel-modal");

    function showToast(message: string, isError = false) {
        if (!toastBox || !toastMessage) return;
        toastMessage.textContent = message;
        toastBox.className = isError
            ? "p-3 border-2 text-xs font-mono shadow-[3px_3px_0px_#000000] flex flex-row items-center justify-between gap-3 bg-[#1F080A] border-[#ffb4ab] text-[#ffdad6]"
            : "p-3 border-2 text-xs font-mono shadow-[3px_3px_0px_#000000] flex flex-row items-center justify-between gap-3 bg-[#003824] border-[#4edea3] text-[#4edea3]";
        toastBox.classList.remove("hidden");
    }

    toastClose?.addEventListener("click", () => {
        toastBox?.classList.add("hidden");
    });

    async function checkAdminAccess(): Promise<boolean> {
        if (!isAuthenticated()) {
            window.location.href = "/login";
            return false;
        }

        const syncedUser = await syncCurrentUser();
        if (syncedUser?.role !== "admin" && !isAdmin()) {
            if (deniedBox && mainContainer) {
                deniedBox.classList.remove("hidden");
                deniedBox.classList.add("flex");
                mainContainer.classList.add("hidden");
            }
            return false;
        }

        if (deniedBox && mainContainer) {
            deniedBox.classList.add("hidden");
            deniedBox.classList.remove("flex");
            mainContainer.classList.remove("hidden");
        }

        return true;
    }

    function updateStats() {
        const total = allFeatures.length;
        const active = allFeatures.filter((f) => f.is_enabled === 1).length;
        const disabled = allFeatures.filter((f) => f.is_enabled === 0).length;

        if (statTotal) statTotal.textContent = String(total);
        if (statActive) statActive.textContent = String(active);
        if (statDisabled) statDisabled.textContent = String(disabled);
    }

    function renderTable() {
        if (!tableBody) return;

        let filtered = allFeatures;

        // Filter
        if (activeFilter === "ACTIVE") {
            filtered = filtered.filter((f) => f.is_enabled === 1);
        } else if (activeFilter === "DISABLED") {
            filtered = filtered.filter((f) => f.is_enabled === 0);
        } else if (activeFilter === "ROOT") {
            filtered = filtered.filter((f) => !f.parent_id);
        } else if (activeFilter === "SUB") {
            filtered = filtered.filter((f) => Boolean(f.parent_id));
        }

        // Search
        if (searchQuery.trim()) {
            const q = searchQuery.toLowerCase().trim();
            filtered = filtered.filter(
                (f) =>
                    f.key.toLowerCase().includes(q) ||
                    (f.description && f.description.toLowerCase().includes(q)),
            );
        }

        if (filtered.length === 0) {
            tableBody.innerHTML = "";
            emptyState?.classList.remove("hidden");
            emptyState?.classList.add("flex");
            return;
        }

        emptyState?.classList.add("hidden");
        emptyState?.classList.remove("flex");

        tableBody.innerHTML = filtered
            .map((feature) => {
                const isEnabled = feature.is_enabled === 1;
                const isSub = Boolean(feature.parent_id);

                const typeBadge = isSub
                    ? `<span class="px-2 py-0.5 text-[10px] font-bold bg-[#1f1f22] text-[#d1c6ab] border border-[#4d4632]">SUB-FITUR</span>`
                    : `<span class="px-2 py-0.5 text-[10px] font-bold bg-[#3c2f00] text-[#ffecb9] border border-[#facc15]">FITUR UTAMA</span>`;

                const statusBadge = isEnabled
                    ? `<span class="px-2 py-0.5 text-[10px] font-bold bg-[#003824] text-[#4edea3] border border-[#4edea3] inline-flex items-center gap-1"><span class="w-1.5 h-1.5 bg-[#4edea3] inline-block"></span> AKTIF</span>`
                    : `<span class="px-2 py-0.5 text-[10px] font-bold bg-[#1F080A] text-[#ffb4ab] border border-[#ffb4ab] inline-flex items-center gap-1"><span class="w-1.5 h-1.5 bg-[#ffb4ab] inline-block"></span> NONAKTIF</span>`;

                const toggleBtn = isEnabled
                    ? `<button
							type="button"
							class="btn-quick-toggle px-2 py-1 bg-[#1F080A] text-[#ffb4ab] hover:bg-[#93000a] border border-[#ffb4ab] cursor-pointer"
							data-id="${feature.id}"
							data-target="0"
						>
							Nonaktifkan
						</button>`
                    : `<button
							type="button"
							class="btn-quick-toggle px-2 py-1 bg-[#003824] text-[#4edea3] hover:bg-[#00a572] hover:text-[#00311f] border border-[#4edea3] cursor-pointer font-bold"
							data-id="${feature.id}"
							data-target="1"
						>
							Aktifkan
						</button>`;

                const desc = feature.description
                    ? escapeHtml(feature.description)
                    : '<span class="text-[#6f6b64] italic">Tidak ada deskripsi</span>';

                return `
					<tr class="hover:bg-[#1b1b1e] transition-colors">
						<td class="py-3 px-4">
							<div class="font-bold text-[#e4e1e6] text-xs font-mono">${escapeHtml(feature.key)}</div>
						</td>
						<td class="py-3 px-4">${typeBadge}</td>
						<td class="py-3 px-4 text-[#d1c6ab] text-[11px]">${desc}</td>
						<td class="py-3 px-4">${statusBadge}</td>
						<td class="py-3 px-4 text-right">
							<div class="flex items-center justify-end gap-1.5">
								${toggleBtn}
								<button
									type="button"
									class="btn-edit-feature px-2 py-1 bg-[#2a2a2d] text-[#ffecb9] hover:bg-[#353438] border border-[#353438] cursor-pointer"
									data-id="${feature.id}"
								>
									Edit
								</button>
							</div>
						</td>
					</tr>
				`;
            })
            .join("");

        // Attach quick toggle listeners
        document.querySelectorAll(".btn-quick-toggle").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const id = btn.getAttribute("data-id");
                const targetStatus = Number(
                    btn.getAttribute("data-target") || "1",
                );
                if (id) await handleQuickToggle(id, targetStatus);
            });
        });

        // Attach edit listeners
        document.querySelectorAll(".btn-edit-feature").forEach((btn) => {
            btn.addEventListener("click", () => {
                const id = btn.getAttribute("data-id");
                if (id) openEditModal(id);
            });
        });
    }

    function escapeHtml(str: string): string {
        return str
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    async function loadFeatures() {
        const res = await fetchAdminFeatures();
        if (!res.ok) {
            if (res.status === 401) {
                window.location.href = "/login";
                return;
            }
            if (res.status === 403) {
                if (deniedBox && mainContainer) {
                    deniedBox.classList.remove("hidden");
                    deniedBox.classList.add("flex");
                    mainContainer.classList.add("hidden");
                }
                return;
            }
            showToast(
                res.error || "Gagal memuat status fitur dari server.",
                true,
            );
            return;
        }

        allFeatures = res.data;
        updateStats();
        renderTable();
    }

    async function handleQuickToggle(id: string, targetStatus: number) {
        const feature = allFeatures.find((f) => f.id === id);
        if (!feature) return;

        const res = await updateAdminFeature({
            id: feature.id,
            key: feature.key,
            is_enabled: targetStatus,
            description: feature.description || "",
        });

        if (!res.ok) {
            showToast(res.error || "Gagal mengubah status fitur.", true);
            return;
        }

        const statusText =
            targetStatus === 1
                ? "diaktifkan"
                : "dinonaktifkan (mode maintenance)";
        showToast(`Fitur "${feature.key}" berhasil ${statusText}!`);
        await loadFeatures();
    }

    function openEditModal(id: string) {
        const feature = allFeatures.find((f) => f.id === id);
        if (!feature) return;

        if (modalFeatureId) modalFeatureId.value = feature.id;
        if (modalFeatureKey) modalFeatureKey.value = feature.key;
        if (modalFeatureDesc)
            modalFeatureDesc.value = feature.description || "";

        const radio = document.querySelector(
            `input[name="feature-status"][value="${feature.is_enabled}"]`,
        ) as HTMLInputElement | null;
        if (radio) radio.checked = true;

        hideModalError();
        editModal?.classList.remove("hidden");
    }

    function closeModal() {
        editModal?.classList.add("hidden");
    }

    function showModalError(msg: string) {
        if (!modalErrorBox) return;
        modalErrorBox.textContent = msg;
        modalErrorBox.classList.remove("hidden");
    }

    function hideModalError() {
        if (!modalErrorBox) return;
        modalErrorBox.classList.add("hidden");
    }

    // Event Handlers
    btnCloseModal?.addEventListener("click", closeModal);
    btnCancelModal?.addEventListener("click", closeModal);

    // Filter buttons
    filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            filterBtns.forEach((b) => {
                b.className =
                    "filter-btn font-mono text-xs px-2.5 py-1 border border-[#353438] bg-[#1b1b1e] text-[#d1c6ab] hover:text-[#e4e1e6]";
            });
            btn.className =
                "filter-btn font-mono text-xs px-2.5 py-1 border border-[#353438] bg-[#facc15] text-[#3c2f00] font-bold";
            activeFilter = btn.getAttribute("data-filter") || "ALL";
            renderTable();
        });
    });

    // Search input
    searchInput?.addEventListener("input", () => {
        searchQuery = searchInput.value;
        renderTable();
    });

    // Submit Modal Form
    featureForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        hideModalError();

        const id = modalFeatureId?.value.trim() || "";
        const key = modalFeatureKey?.value.trim() || "";
        const description = modalFeatureDesc?.value.trim() || "";
        const statusEl = document.querySelector(
            'input[name="feature-status"]:checked',
        ) as HTMLInputElement | null;
        const is_enabled = Number(statusEl?.value ?? "1");

        if (!id || !key) {
            showModalError("ID dan kunci fitur tidak valid.");
            return;
        }

        const res = await updateAdminFeature({
            id,
            key,
            is_enabled,
            description,
        });

        if (!res.ok) {
            showModalError(res.error || "Gagal menyimpan perubahan fitur.");
            return;
        }

        closeModal();
        showToast(`Sakelar fitur "${key}" berhasil diperbarui!`);
        await loadFeatures();
    });

    // Initialize
    (async () => {
        if (await checkAdminAccess()) {
            await loadFeatures();
        }
    })();
</script>
