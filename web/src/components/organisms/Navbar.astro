---
// web/src/components/organisms/Navbar.astro
---

<header class="fixed top-0 left-0 w-full z-50 bg-[#0e0e11] border-b-2 border-[#353438]">
	<div class="h-[60px] w-full px-4 md:px-8 flex items-center justify-between">
		<div class="flex items-center gap-4">
			<a href="/" class="flex items-center gap-2">
				<div class="w-8 h-8 bg-[#facc15] border-2 border-black flex items-center justify-center font-bold text-black text-lg shadow-[2px_2px_0px_#000000]">
					K
				</div>
				<span class="font-['Space_Grotesk'] text-lg text-[#e4e1e6] uppercase tracking-wider font-bold">KODINGAN</span>
			</a>
			<span class="font-mono text-xs bg-[#2a2a2d] text-[#d1c6ab] px-2 py-0.5 border border-[#4d4632] font-medium">v0.1.0</span>
		</div>

		<nav class="hidden md:flex items-center gap-2">
			<a id="nav-link-courses" class="font-mono text-xs px-3 py-1.5 text-[#d1c6ab] bg-[#1b1b1e] border border-[#353438] hover:bg-[#1f1f22] hover:text-[#e4e1e6]" href="#">[ Jalur Belajar ]</a>
			<a id="nav-link-playground" class="font-mono text-xs px-3 py-1.5 border border-[#353438] bg-[#facc15] text-[#3c2f00] font-bold shadow-[2px_2px_0px_#000000]" href="/playground">[ Area Uji Coba ]</a>
			<a id="nav-link-practice" class="font-mono text-xs px-3 py-1.5 text-[#d1c6ab] bg-[#1b1b1e] border border-[#353438] hover:bg-[#1f1f22] hover:text-[#e4e1e6]" href="#">[ Latihan Soal ]</a>
		</nav>

		<!-- Auth Actions (Guest vs Authenticated) -->
		<div class="flex items-center gap-3" id="nav-auth-container">
			<!-- Guest State -->
			<div class="flex items-center gap-2" id="nav-guest-links">
				<a class="font-mono text-xs px-3 py-1.5 bg-[#1f1f22] text-[#e4e1e6] border-2 border-[#353438] hover:bg-[#2a2a2d] shadow-[2px_2px_0px_#000000] cursor-pointer" href="/login">[ Masuk ]</a>
				<a class="font-mono text-xs px-3 py-1.5 bg-[#facc15] text-[#3c2f00] font-bold border-2 border-[#0e0e11] shadow-[4px_4px_0px_#000000] hover:translate-x-0.5 hover:translate-y-0.5 active:translate-x-1 active:translate-y-1 active:shadow-none cursor-pointer" href="/register">[ Daftar Akun ]</a>
			</div>

			<!-- Logged-in State (Initially hidden, revealed if token exists) -->
			<div class="hidden items-center gap-3" id="nav-user-profile">
				<div class="flex items-center gap-2 px-3 py-1 bg-[#1f1f22] border-2 border-[#353438] shadow-[2px_2px_0px_#000000]">
					<span class="w-2 h-2 bg-[#4edea3] rounded-full animate-pulse"></span>
					<span class="font-mono text-xs text-[#e4e1e6] font-bold" id="nav-username">User</span>
				</div>
				<button
					id="nav-btn-logout"
					class="font-mono text-xs px-3 py-1.5 bg-[#2a2a2d] text-[#ffb4ab] border-2 border-[#353438] hover:bg-[#353438] shadow-[2px_2px_0px_#000000] cursor-pointer"
					type="button"
				>
					[ Keluar ]
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	import { getCurrentUser, clearSession } from '@/lib/auth';
	import { getFeatureFlags } from '@/lib/feature-flags';

	function syncNavbarAuth() {
		const user = getCurrentUser();
		const guestLinks = document.getElementById('nav-guest-links');
		const userProfile = document.getElementById('nav-user-profile');
		const usernameEl = document.getElementById('nav-username');
		const logoutBtn = document.getElementById('nav-btn-logout');

		if (user && guestLinks && userProfile) {
			guestLinks.classList.add('hidden');
			userProfile.classList.remove('hidden');
			userProfile.classList.add('flex');
			if (usernameEl) usernameEl.textContent = user.username;
		} else if (guestLinks && userProfile) {
			guestLinks.classList.remove('hidden');
			userProfile.classList.add('hidden');
			userProfile.classList.remove('flex');
		}

		logoutBtn?.addEventListener('click', () => {
			clearSession();
			window.location.href = '/login';
		});
	}

	async function syncNavbarFeatureFlags() {
		try {
			const flags = await getFeatureFlags();
			const linkPlayground = document.getElementById('nav-link-playground') as HTMLAnchorElement | null;
			const linkCourses = document.getElementById('nav-link-courses') as HTMLAnchorElement | null;
			const linkPractice = document.getElementById('nav-link-practice') as HTMLAnchorElement | null;

			// Sinkronisasi status Playground
			if (linkPlayground) {
				if (flags.playground === false) {
					linkPlayground.className = 'font-mono text-xs px-3 py-1.5 border border-[#ffb4ab] bg-[#2d1600] text-[#ffb4ab] font-bold shadow-[2px_2px_0px_#000000]';
					linkPlayground.textContent = '[ Area Uji Coba (Perbaikan) ]';
					linkPlayground.href = '/maintenance?feature=playground';
				} else {
					linkPlayground.className = 'font-mono text-xs px-3 py-1.5 border border-[#353438] bg-[#facc15] text-[#3c2f00] font-bold shadow-[2px_2px_0px_#000000]';
					linkPlayground.textContent = '[ Area Uji Coba ]';
					linkPlayground.href = '/playground';
				}
			}

			// Sinkronisasi status Courses
			if (linkCourses) {
				if (flags.courses || flags.course) {
					linkCourses.className = 'font-mono text-xs px-3 py-1.5 border border-[#353438] bg-[#1b1b1e] text-[#e4e1e6] hover:bg-[#1f1f22]';
					linkCourses.textContent = '[ Jalur Belajar ]';
					linkCourses.href = '/courses';
				} else {
					linkCourses.className = 'font-mono text-xs px-3 py-1.5 border border-[#2a2a2d] bg-[#141416] text-[#6f6b64] cursor-not-allowed';
					linkCourses.textContent = '[ Jalur Belajar (Segera) ]';
					linkCourses.href = '/maintenance?feature=courses';
				}
			}

			// Sinkronisasi status Practice
			if (linkPractice) {
				if (flags.practice) {
					linkPractice.className = 'font-mono text-xs px-3 py-1.5 border border-[#353438] bg-[#1b1b1e] text-[#e4e1e6] hover:bg-[#1f1f22]';
					linkPractice.textContent = '[ Latihan Soal ]';
					linkPractice.href = '/practice';
				} else {
					linkPractice.className = 'font-mono text-xs px-3 py-1.5 border border-[#2a2a2d] bg-[#141416] text-[#6f6b64] cursor-not-allowed';
					linkPractice.textContent = '[ Latihan Soal (Segera) ]';
					linkPractice.href = '/maintenance?feature=practice';
				}
			}
		} catch (err) {
			console.warn('Gagal sinkronisasi feature flags di navbar:', err);
		}
	}

	syncNavbarAuth();
	syncNavbarFeatureFlags();
</script>
