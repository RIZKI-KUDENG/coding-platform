---
// web/src/components/lesson/LessonHeader.astro
---

<div class="w-full bg-[#0e0e11] border-2 border-[#353438] shadow-[6px_6px_0px_#000000] overflow-hidden">
	<div class="w-full bg-[#1b1b1e] border-b-2 border-[#353438] px-4 py-2 flex items-center justify-between">
		<div class="flex items-center gap-2">
			<span class="w-2.5 h-2.5 bg-[#facc15] inline-block border border-black"></span>
			<span id="lesson-header-badge" class="font-mono text-xs font-bold text-[#ffecb9] tracking-wider uppercase">
				LESSON // VIEW
			</span>
		</div>
		<span id="exercise-counter-badge" class="font-mono text-[11px] text-[#d1c6ab] bg-[#2a2a2d] px-2 py-0.5 border border-[#353438]">
			0 LATIHAN TERSEDIA
		</span>
	</div>

	<div class="p-5 md:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
		<div class="flex flex-col gap-1.5">
			<h1 id="lesson-title" class="font-['Space_Grotesk'] text-2xl md:text-3xl font-bold text-[#e4e1e6] uppercase tracking-tight">
				Judul Pelajaran
			</h1>
			<p id="lesson-desc" class="font-mono text-xs md:text-sm text-[#d1c6ab] leading-relaxed max-w-3xl">
				Deskripsi dan pengantar modul pelajaran.
			</p>
		</div>
		<!-- Right Lesson Action -->
		<div class="flex items-center gap-2 shrink-0">
			<a
				id="btn-goto-playground"
				href="/playground"
				class="font-mono text-xs px-3 py-1.5 bg-[#1f1f22] text-[#e4e1e6] border border-[#353438] hover:bg-[#2a2a2d] shadow-[2px_2px_0px_#000000] transition-colors"
			>
				Area Uji Bebas &rarr;
			</a>
		</div>
	</div>
</div>
